{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__jev_path=/$1"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "jev-routing-v1.1.0": false
    }
  }
}
