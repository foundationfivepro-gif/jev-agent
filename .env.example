# Transport: OpenRouter's System One API (openrouter.ai/api/v1/systemone). From 1Password:
#   op read 'op://Foundation Five/OpenRouter API Key - Claude/credential'
OPENROUTER_API_KEY=
# JEV_OPENROUTER_MODEL=jev-latest        # or pin a release, e.g. jev-1.13

# Fallback: TypeSafe's own API, used only when OPENROUTER_API_KEY is unset.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Legacy: the Vercel AI Gateway, used only when neither key above is set.
# AI_GATEWAY_API_KEY=
# JEV_GATEWAY_MODEL=typesafe-ai/jev

# Questions per call. 50 is the measured-reliable ceiling on this transport.
# State size matters more than question count — see decide_batched.
JEV_MAX_QUESTIONS=50

# Wall-clock cap on one Jev call, retries included. Past it the caller's no-answer
# default applies. Raise it for offline batch jobs that can wait out a 429.
JEV_DEADLINE_S=15

JEV_TRACE_DIR=traces
