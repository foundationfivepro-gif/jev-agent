# Transport: Vercel AI Gateway. This is the only transport.
AI_GATEWAY_API_KEY=
JEV_GATEWAY_MODEL=typesafe-ai/jev

# Questions per call. 50 is the measured-reliable ceiling on this transport.
# State size matters more than question count — see decide_batched.
JEV_MAX_QUESTIONS=50
JEV_TRACE_DIR=traces
